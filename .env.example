JARVIS_OLLAMA_MODEL=llama3
JARVIS_MEMORY_DB=data/jarvis.sqlite3
JARVIS_LEGACY_MEMORY=jarvis_memory.json
JARVIS_SPEAKER_RATE=2
JARVIS_FLASK_PORT=5000

# Speech-to-text:
# auto = try Faster-Whisper first, then Google fallback.
# faster_whisper = force offline transcription.
# google = legacy online transcription.
JARVIS_STT_BACKEND=auto
JARVIS_WHISPER_MODEL_SIZE=base
JARVIS_WHISPER_DEVICE=cpu
JARVIS_WHISPER_COMPUTE_TYPE=int8

# Wake word:
# Porcupine requires PICOVOICE_ACCESS_KEY. Without it, auto mode falls back
# to a lightweight spoken wake-word check using the configured STT backend.
JARVIS_WAKE_WORD_ENABLED=true
JARVIS_WAKE_WORD_ENGINE=auto
JARVIS_WAKE_WORD=jarvis
PICOVOICE_ACCESS_KEY=

# Vision:
# auto = try Ollama vision model first, then OCR fallback.
# ollama = force local vision model analysis.
# ocr = read visible text with Tesseract OCR.
JARVIS_SCREENSHOTS_DIR=data/screenshots
JARVIS_SCREEN_CAPTURE_BACKEND=auto
JARVIS_VISION_BACKEND=auto
JARVIS_VISION_MODEL=llava
JARVIS_OCR_BACKEND=auto
TESSERACT_CMD=
